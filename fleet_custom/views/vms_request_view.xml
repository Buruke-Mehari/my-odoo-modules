<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vms_request_tree" model="ir.ui.view">
        <field name="name">vms.request.tree</field>
        <field name="model">vms.request</field>
        <field name="arch" type="xml">
            <tree string="Vehicle Requests">
                <field name="create_date" string="Date"/>
                <field name="request_category"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_vms_request_form" model="ir.ui.view">
        <field name="name">vms.request.form</field>
        <field name="model">vms.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Request">
                <header>
                    <button name="action_submit_to_fleet" string="Submit to Fleet" type="object" 
                            class="oe_highlight" 
                            invisible="state != 'draft'"
                            groups="fleet_custum.group_vms_driver"/>
                    
                    <button name="action_return_to_draft" 
                            string="Return to Draft" 
                            type="object" 
                            invisible="state != 'specification'"
                            groups="fleet_custum.group_vms_fleet_operator"
                            context="{'validate': False}"/>

                    <button name="action_submit_to_supervisor" string="Send to Supervisor" type="object" 
                            class="oe_highlight" 
                            invisible="state != 'specification'"
                            groups="fleet_custum.group_vms_fleet_operator"/>
                    
                     <button name="action_return_to_specification" 
                            string="Return to Specification" 
                            type="object" 
                            invisible="state != 'supervisor'"
                            groups="fleet_custum.group_vms_asset_supervisor"
                            context="{'validate': False}"/>

                    <button name="action_submit_to_approval" string="Send to Manager" type="object" 
                            class="oe_highlight" 
                            invisible="state != 'supervisor'"
                            groups="fleet_custum.group_vms_asset_supervisor"/>

                    <button name="action_return_to_supervisor" 
                            string="Return to Supervisor" 
                            type="object" 
                            invisible="state != 'approval'"
                            groups="fleet_custum.group_vms_general_manager"
                            context="{'validate': False}"/>

                    <button name="action_submit_to_approved" string="Send to Finance" type="object" 
                            class="oe_highlight" 
                            invisible="state != 'approval'"
                            groups="fleet_custum.group_vms_general_manager"/>       


                    <field name="state" widget="statusbar" statusbar_visible="draft,specification,supervisor,approval,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Driver Request">
                            <field name="request_category" readonly="state != 'draft'"/>
                        </group>

                        <group string="Fleet Specification" 
                               invisible="state == 'draft'"
                               groups="fleet_custum.group_vms_fleet_operator">
                         
                            <field name="total_cost" readonly="state != 'specification'"/>
                            <field name="fuel_qty" readonly="state != 'specification'" invisible="request_category != 'fuel'"/>
                            
                            <field name="vehicle_id" 
       readonly="state != 'specification'" 
       options="{'no_create': True, 'no_open': True}"/>
                            <field name="contract_type" invisible="request_category != 'contract'" readonly="state != 'specification'"/>
                            <field name="service_type" invisible="request_category != 'service'" readonly="state != 'specification'"/>
                            <field name="maintenance_type" invisible="request_category != 'maintenance'" readonly="state != 'specification'"/>
                        </group>
                       
                        <group string="Supervisor Approval"
       groups="fleet_custum.group_vms_asset_supervisor">
       </group>
                         <group string="Manager" 
                        
                         groups="fleet_custum.group_vms_general_manager">
                           
                        </group>
                    </group>

                   <notebook>
<page string="Photos" name="photos">
    <field name="photo_ids" readonly="state != 'draft'">
        <tree string="Photos">
            <field name="image" widget="image" options="{'size': [90, 90]}"/>
            <field name="description"/>
            
            <control>
                <create name="add_photo_control" string="Upload Photo" class="btn btn-primary"/>
            </control>
        </tree>
    </field>
</page>
</notebook>
                </sheet>
            </form>
        </field>
    </record>


<record id="view_vms_request_photo_form" model="ir.ui.view">
    <field name="name">vms.request.photo.form</field>
    <field name="model">vms.request.photo</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="image" widget="image" class="oe_avatar" 
                           options="{'preview_image': 'image', 'size': [200, 200]}"/>
                    <field name="description" placeholder="e.g. Front bumper damage"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
    <record id="action_vms_request" model="ir.actions.act_window">
        <field name="name">Vehicle Requests</field>
        <field name="res_model">vms.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vms_root" name="VMS" web_icon="base,static/description/icon.png" sequence="10"/>
    <menuitem id="menu_vms_requests" name="Requests" parent="menu_vms_root" action="action_vms_request" sequence="10"/>
</odoo>